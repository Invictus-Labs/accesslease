{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential.json",
  "title": "One-time credential delivery",
  "$defs": {
    "CredentialDelivery": {
      "type": "object",
      "properties": {
        "lease_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "provider": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "synthetic",
                "postgres-role"
              ]
            },
            "label": {
              "type": "string",
              "enum": [
                "SYNTHETIC",
                "LIVE_LOCAL_POSTGRES"
              ]
            },
            "live": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "label",
            "live"
          ],
          "additionalProperties": false
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "credential": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "synthetic",
                "postgres-role"
              ]
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "database": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "secret": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "host",
            "port",
            "database",
            "username",
            "secret"
          ],
          "additionalProperties": false
        },
        "delivered_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "lease_id",
        "provider",
        "expires_at",
        "credential",
        "delivered_at"
      ],
      "additionalProperties": false
    }
  }
}
