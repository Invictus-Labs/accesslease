{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approval.json",
  "title": "Approval request bound to a plan hash",
  "$defs": {
    "ApproveRequest": {
      "type": "object",
      "properties": {
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "plan_hash"
      ],
      "additionalProperties": false
    }
  }
}
