# Copy to .env and replace every placeholder. The placeholders are deliberately invalid:
# AccessLease refuses to start (and compose refuses to run) until real values are supplied.
# Never commit .env. Generate values on the machine that will run the service.

# Password for the bundled PostgreSQL container that stores AccessLease metadata.
# Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=replace-with-a-generated-database-password

# 32 random bytes, base64. Encrypts issued credentials and probe secrets at rest and signs CSRF tokens.
# It lives outside the database: losing it makes stored secrets unreadable; leaking it defeats the encryption.
# Generate one with:  openssl rand -base64 32
ACCESSLEASE_SECRET_KEY=replace-with-openssl-rand-base64-32

# The address people use in their browser. Only a plain http:// URL disables the Secure cookie flag
# (acceptable for a local demo on localhost). Behind a TLS reverse proxy use your https URL.
ACCESSLEASE_PUBLIC_URL=http://localhost:8791

# Provider: synthetic (labelled SYNTHETIC, never live evidence) or postgres-role (real local PostgreSQL provider).
ACCESSLEASE_PROVIDER=synthetic

# Only for ACCESSLEASE_PROVIDER=postgres-role. Admin URL of a SEPARATE, disposable PostgreSQL cluster
# (never the metadata database). Use compose.provider.yaml for a throwaway one next to the app.
ACCESSLEASE_PROVIDER_ADMIN_URL=
# Password for the throwaway provider cluster started by compose.provider.yaml.
PROVIDER_DB_PASSWORD=replace-with-a-generated-provider-password

# Outbound allowlist for provider endpoints (host, host:port, ip or CIDR, comma separated).
# Leave empty to allow no outbound endpoint. compose.provider.yaml sets the value it needs.
ACCESSLEASE_EGRESS_ALLOWLIST=

# Lease policy defaults (admins can change them later in the UI). Hard maximum default: 8 hours.
ACCESSLEASE_TTL_DEFAULT_SECONDS=3600
ACCESSLEASE_TTL_MAX_SECONDS=28800
ACCESSLEASE_RETENTION_DAYS=90

# Optional ecosystem event consumer (reference adapter). Disabled unless set to 1. See docs/ADAPTERS.md.
# ACCESSLEASE_ADAPTER_ENABLED=0
